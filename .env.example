# -------------------------------------------------------------
# AUCTIONCRAZE — ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------

# PORTS
PORT=4001
WEB_PORT=3001
ML_PORT=8001
NODE_ENV=development

# FRONTEND / CORS ORIGINS (Comma-separated allowlist for CORS & Socket.IO)
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4001/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001
CORS_ORIGIN=http://localhost:3001

# POSTGRESQL (Independent port 5433)
DATABASE_URL="postgresql://auctioncraze:auctioncraze_dev_password@localhost:5433/auctioncraze_db?schema=public"

# REDIS (Independent port 6380)
REDIS_URL="redis://localhost:6380"

# AUTHENTICATION & GUEST SESSIONS (Must be 32+ chars; required in production)
JWT_SECRET=replace_with_a_cryptographically_random_64_char_secret_key_here
JWT_EXPIRES_IN=7d
GUEST_SESSION_TTL_SECONDS=604800

# ML SERVICE
ML_SERVICE_URL=http://localhost:8001
INTERNAL_ML_SERVICE_KEY=replace_with_a_cryptographically_random_64_char_secret_key_here
