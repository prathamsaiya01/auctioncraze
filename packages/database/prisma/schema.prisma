datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

enum RoomStatus {
  LOBBY
  LIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum AuctionMode {
  MOCK
  MEGA
  CUSTOM
}

enum RoomRole {
  HOST
  OWNER
  SPECTATOR
}

enum LotStatus {
  QUEUED
  ACTIVE
  BIDDING_CLOSED
  SOLD
  UNSOLD
  SKIPPED
}

enum CricketRole {
  BATSMAN
  BOWLER
  ALL_ROUNDER
  WICKET_KEEPER
}

enum BattingStyle {
  RIGHT_HAND
  LEFT_HAND
}

enum BowlingStyle {
  RIGHT_ARM_FAST
  RIGHT_ARM_MEDIUM
  RIGHT_ARM_SPIN
  LEFT_ARM_FAST
  LEFT_ARM_MEDIUM
  LEFT_ARM_SPIN
  NONE
}

enum LedgerEntryType {
  INITIAL
  DEDUCTION
  RETENTION_DEDUCTION
  PURSE_ADJUSTMENT
  REFUND_REVERSAL
}

// -------------------------------------------------------------
// GUEST SESSIONS & OPTIONAL ACCOUNTS (NO SUPER ADMIN)
// -------------------------------------------------------------

model GuestSession {
  id          String   @id @default(uuid())
  tokenSecret String
  displayName String
  avatarSeed  String
  expiresAt   DateTime
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  participants RoomParticipant[]
  chatMessages ChatMessage[]

  @@index([expiresAt])
}

// -------------------------------------------------------------
// MULTIPLAYER ROOMS & FRANCHISES
// -------------------------------------------------------------

model Room {
  id                        String         @id @default(uuid())
  code                      String         @unique
  name                      String
  visibility                RoomVisibility @default(PUBLIC)
  inviteToken               String?
  status                    RoomStatus     @default(LOBBY)
  auctionMode               AuctionMode    @default(MEGA)
  hostParticipantId         String?
  version                   Int            @default(1)
  initialPurseLakhs         Int            @default(10000)
  minSquadSize              Int            @default(15)
  maxSquadSize              Int            @default(25)
  maxOverseas               Int            @default(8)
  maxSpectators             Int            @default(20)
  minOwnersRequired         Int            @default(2)
  defaultBasePriceLakhs     Int            @default(50)
  bidIncrementTiersJson     Json?
  countdownSeconds          Int            @default(20)
  allowLateBidExtension     Boolean        @default(true)
  bidExtensionSeconds       Int            @default(10)
  extensionThresholdSeconds Int            @default(5)
  allowHostSkip             Boolean        @default(true)
  allowTeamPurseAdjustments Boolean        @default(false)
  allowPlayerTrades         Boolean        @default(false)
  allowCustomTeamName       Boolean        @default(false)
  allowLateJoin             Boolean        @default(true)
  retentionEnabled          Boolean        @default(false)
  maxRetentionsPerFranchise Int            @default(4)
  maxOverseasRetentions     Int            @default(2)
  configFinalized           Boolean        @default(false)
  configFinalizedAt         DateTime?
  isPaused                  Boolean        @default(false)
  currentLotId              String?
  timerDeadlineMs           BigInt?
  timerRemainingMs          Int?
  startedAt                 DateTime?
  endedAt                   DateTime?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt

  franchises   RoomFranchise[]
  participants RoomParticipant[]
  lots         RoomPlayerLot[]
  retentions   RoomRetention[]
  events                AuctionEvent[]
  chatMessages          ChatMessage[]
  postAuctionSnapshots  PostAuctionRatingSnapshot[]
  tradeProposals        TradeProposal[]

  @@index([visibility, status])
  @@index([code])
}

model RoomFranchise {
  id                   String   @id @default(uuid())
  roomId               String
  presetCode           String
  name                 String
  customSuffix         String?
  abbreviation         String
  primaryColor         String
  secondaryColor       String
  initialPurseLakhs    Int
  purseAdjustmentLakhs Int      @default(0)
  remainingPurseLakhs  Int
  squadCount           Int      @default(0)
  overseasCount        Int      @default(0)
  retainedCount        Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  room        Room             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  owner       RoomParticipant?
  retentions  RoomRetention[]
  bids                   Bid[]
  purchases              Purchase[]
  purseLedger            PurseLedger[]
  outgoingTradeProposals TradeProposal[] @relation("TradeProposerFranchise")
  incomingTradeProposals TradeProposal[] @relation("TradeReceiverFranchise")

  @@unique([roomId, presetCode])
  @@index([roomId])
}

model RoomRetention {
  id                 String   @id @default(uuid())
  roomId             String
  franchiseId        String
  playerId           String
  retentionCostLakhs Int
  slotNumber         Int
  createdAt          DateTime @default(now())

  room      Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  franchise RoomFranchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  player    MasterPlayer  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([roomId, playerId])
  @@index([roomId, franchiseId])
}

model RoomParticipant {
  id              String    @id @default(uuid())
  roomId          String
  guestSessionId  String
  displayName     String
  role            RoomRole  @default(OWNER)
  franchiseId     String?   @unique // Enforces 1 user per franchise in DB!
  isReady         Boolean   @default(false)
  isConnected     Boolean   @default(true)
  isRemoved       Boolean   @default(false)
  lastHeartbeatAt DateTime  @default(now())
  joinedAt        DateTime  @default(now())
  leftAt          DateTime?

  room         Room           @relation(fields: [roomId], references: [id], onDelete: Cascade)
  guestSession GuestSession   @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)
  franchise    RoomFranchise? @relation(fields: [franchiseId], references: [id], onDelete: SetNull)
  bids         Bid[]

  @@unique([roomId, guestSessionId])
  @@index([roomId, role])
}

// -------------------------------------------------------------
// CENTRALIZED PLAYER DATABASE (SEPARATE FROM ROOM LOT STATE)
// -------------------------------------------------------------

model MasterPlayer {
  id               String        @id @default(uuid())
  externalKey      String?       @unique
  cricsheetId      String?       @unique
  cricinfoId       String?
  fullName         String
  nationality      String?
  isOverseas       Boolean       @default(false)
  dateOfBirth      DateTime?
  age              Int?
  playingRole      CricketRole   @default(ALL_ROUNDER)
  secondaryRole    CricketRole?
  battingStyle     BattingStyle?
  bowlingStyle     BowlingStyle?
  basePriceLakhs   Int           @default(50)
  imageUrl         String?
  teamHistoryJson  Json?
  iplDebutYear     Int?
  iplLastYear      Int?
  provenanceSource String?
  seasonCoverage   String?
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  seasonStats PlayerSeasonStat[]
  lots        RoomPlayerLot[]
  retentions  RoomRetention[]
  purchases   Purchase[]
  tradeItems  TradeProposalItem[]

  @@index([fullName])
  @@index([cricinfoId])
  @@index([nationality, playingRole])
  @@index([playingRole, isOverseas])
}

model PlayerSeasonStat {
  id                String   @id @default(uuid())
  playerId          String
  season            Int
  teamCode          String?
  matches           Int?
  innings           Int?
  battingInnings    Int?
  bowlingInnings    Int?
  runs              Int?
  ballsFaced        Int?
  notOuts           Int?
  highestScore      Int?
  highestScoreText  String?
  battingAverage    Decimal? @db.Decimal(6, 2)
  strikeRate        Decimal? @db.Decimal(6, 2)
  fifties           Int?
  hundreds          Int?
  wickets           Int?
  ballsBowled       Int?
  runsConceded      Int?
  bowlingAverage    Decimal? @db.Decimal(6, 2)
  economy           Decimal? @db.Decimal(6, 2)
  bowlingStrikeRate Decimal? @db.Decimal(6, 2)
  bestBowling       String?
  catches           Int?
  stumpings         Int?
  provenanceSource  String?

  player MasterPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, season])
  @@index([season])
}

model PlayerImportBatch {
  id                 String    @id @default(uuid())
  sourceName         String
  fileName           String?
  importMode         String    // PLAYERS | SEASONS
  status             String    // PREVIEW | COMMITTED | ROLLED_BACK | FAILED
  totalRows          Int       @default(0)
  insertedCount      Int       @default(0)
  updatedCount       Int       @default(0)
  skippedCount       Int       @default(0)
  errorCount         Int       @default(0)
  insertedPlayerIds  Json?
  errorsJson         Json?
  provenanceNotes    String?
  createdBySessionId String?
  createdAt          DateTime  @default(now())
  rolledBackAt       DateTime?

  @@index([createdAt])
}

// -------------------------------------------------------------
// ROOM-SCOPED AUCTION LOTS, BIDS & LEDGER
// -------------------------------------------------------------

model RoomPlayerLot {
  id                 String    @id @default(uuid())
  roomId             String
  playerId           String
  roundNumber        Int       @default(1)
  sequenceOrder      Int
  setCategory        String    @default("Marquee")
  basePriceLakhs     Int
  currentBidLakhs    Int       @default(0)
  winningFranchiseId String?
  status             LotStatus @default(QUEUED)
  biddingClosedAt    DateTime?
  startedAt          DateTime?
  settledAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  room     Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  player   MasterPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  bids     Bid[]
  purchase Purchase?

  @@unique([roomId, playerId])
  @@index([roomId, sequenceOrder])
  @@index([roomId, status])
}

model Bid {
  id             String   @id @default(uuid())
  lotId          String
  franchiseId    String
  participantId  String
  bidAmountLakhs Int
  roundNumber    Int      @default(1)
  sequenceNumber Int
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())

  lot         RoomPlayerLot   @relation(fields: [lotId], references: [id], onDelete: Cascade)
  franchise   RoomFranchise   @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  participant RoomParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([lotId, sequenceNumber])
  @@index([franchiseId])
}

model Purchase {
  id                 String   @id @default(uuid())
  lotId              String   @unique
  roomId             String
  franchiseId        String
  playerId           String
  purchasePriceLakhs Int
  soldAt             DateTime @default(now())

  lot         RoomPlayerLot @relation(fields: [lotId], references: [id], onDelete: Cascade)
  franchise   RoomFranchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  player      MasterPlayer  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  purseLedger PurseLedger?

  @@index([roomId, franchiseId])
}

model PurseLedger {
  id                String          @id @default(uuid())
  franchiseId       String
  purchaseId        String?         @unique
  entryType         LedgerEntryType
  amountLakhs       Int
  balanceAfterLakhs Int
  description       String
  createdAt         DateTime        @default(now())

  franchise RoomFranchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  purchase  Purchase?     @relation(fields: [purchaseId], references: [id], onDelete: SetNull)

  @@index([franchiseId])
}

model AuctionEvent {
  id             String   @id @default(uuid())
  roomId         String
  sequenceNumber Int
  roomVersion    Int
  eventType      String
  payload        Json
  createdAt      DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, sequenceNumber])
}

model ChatMessage {
  id             String   @id @default(uuid())
  roomId         String
  guestSessionId String
  senderName     String
  franchiseCode  String?
  message        String
  createdAt      DateTime @default(now())

  room         Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  guestSession GuestSession @relation(fields: [guestSessionId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

// -------------------------------------------------------------
// ML SERVICE REGISTRY & AUDIT BOUNDARY (NO BIDDING ADVICE)
// -------------------------------------------------------------

model MLModelRegistry {
  id               String   @id @default(uuid())
  modelKey         String   // PLAYER_RATING, PERFORMANCE_PRED, TEAM_STRENGTH, PLAYING_XI, MATCH_PRED
  version          String
  algorithm        String
  trainSplitStart  String
  trainSplitEnd    String
  testSplitStart   String
  testSplitEnd     String
  metricsJson      Json?
  artifactPath     String?
  isActive         Boolean  @default(false)
  trainedAt        DateTime @default(now())

  @@unique([modelKey, version])
}

model PostAuctionRatingSnapshot {
  id                String   @id @default(uuid())
  roomId            String
  snapshotVersion   Int
  rosterFingerprint String
  calculatedAt      DateTime @default(now())
  triggeredByRole   String
  summaryJson       Json

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, snapshotVersion])
  @@index([roomId, calculatedAt])
}

// -------------------------------------------------------------
// PHASE 6D: PLAYER-FOR-PLAYER FRANCHISE TRADING SYSTEM
// -------------------------------------------------------------

enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
}

enum TradeDirection {
  OUTGOING
  INCOMING
}

model TradeProposal {
  id                    String      @id @default(uuid())
  roomId                String
  proposerFranchiseId   String
  receiverFranchiseId   String
  proposerParticipantId String
  receiverParticipantId String
  status                TradeStatus @default(PENDING)
  idempotencyKey        String      @unique
  acceptIdempotencyKey  String?     @unique
  note                  String?
  failureReason         String?
  expiresAt             DateTime
  respondedAt           DateTime?
  executedAt            DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  room              Room                @relation(fields: [roomId], references: [id], onDelete: Cascade)
  proposerFranchise RoomFranchise       @relation("TradeProposerFranchise", fields: [proposerFranchiseId], references: [id], onDelete: Cascade)
  receiverFranchise RoomFranchise       @relation("TradeReceiverFranchise", fields: [receiverFranchiseId], references: [id], onDelete: Cascade)
  items             TradeProposalItem[]

  @@index([roomId, status])
  @@index([proposerFranchiseId, status])
  @@index([receiverFranchiseId, status])
  @@index([expiresAt, status])
}

model TradeProposalItem {
  id              String         @id @default(uuid())
  tradeId         String
  playerId        String
  sourceType      String         // AUCTION | RETENTION
  direction       TradeDirection // OUTGOING (proposer->receiver) | INCOMING (receiver->proposer)
  fromFranchiseId String
  toFranchiseId   String
  priceLakhs      Int

  trade  TradeProposal @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  player MasterPlayer  @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([tradeId, playerId])
  @@index([playerId])
}
